# PostgreSQL 接続（Prisma datasource）
# 値はダミー。実環境では各自の .env に実値を設定すること（.env はコミットしない）。
DATABASE_URL="postgresql://lapsy:lapsy@localhost:5432/lapsy?schema=public"

# docker-compose 用（compose が参照する）
POSTGRES_USER="lapsy"
POSTGRES_PASSWORD="lapsy"
POSTGRES_DB="lapsy"

# ── 認証（Auth.js v5 / LAP-002）──
# AUTH_SECRET が v5 の正式名。openssl rand -base64 32 等で生成し .env にのみ実値を置く。
AUTH_SECRET=""
# 任意（v5 は自動推論可。本番では明示推奨）
AUTH_URL="http://localhost:3000"

# ── 初期管理者 seed（prisma/seed.ts が読む。ハードコード禁止・未設定はエラー終了）──
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── メール送信（Resend / LAP-003）──
# RESEND_API_KEY 未設定でも build / test / 招待作成は動作する（NoopMailer に
# フォールバックし、メール送信のみスキップして inviteUrl をログ出力する）。
# 実値は .env のみに置く（コミット禁止）。
RESEND_API_KEY=""
# 送信元アドレス。開発はテスト用ドメイン。本番はドメイン認証後に独自ドメインへ。
MAIL_FROM="onboarding@resend.dev"
# 招待リンクの base URL は上の AUTH_URL を流用する（招待メール内リンク生成に使用）。
