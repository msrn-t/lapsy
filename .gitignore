# ============================================================
# Kenesis Loop Kit - .gitignore（パブリックリポジトリ用）
# tickets/ をコミット対象から除外する設定
# ============================================================

# チケット全体を除外（作業ログ・内部情報を公開しない）
tickets/

# テンプレートのみ共有したい場合は以下のコメントを外す
# !tickets/Templates/
# !tickets/Templates/**

# Python生成ファイル（hook/metrics/testのコンパイル成果物）
__pycache__/
*.py[cod]

# OS生成ファイル
.DS_Store
Thumbs.db

# エディタ設定
.vscode/
.idea/

# Claude Code のエージェントメモリ（環境依存パス・ローカル資産）
.claude/projects/

# ============================================================
# Lapsy アプリ（Node / Next.js / Prisma）
# ============================================================

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
# next-env.d.ts はコミット対象（無視しない）

# Prisma（生成クライアントを node_modules 外に出力する場合に備える）
/prisma/generated/

# ビルド/ログ
*.log

# 環境変数・秘密情報（CLAUDE.md セキュリティ規約）
.env
.env.*
!.env.example
*.pem
*.key
secrets/
